APP_ENV=development
DATABASE_PATH=./data/task_evidence_lab.db
MAX_IMPORT_BYTES=1048576
AI_ENABLED=false
TASK_EVIDENCE_DEPLOYMENT_PROFILE=local
TASK_EVIDENCE_PUBLIC_BASE_URL=
TASK_EVIDENCE_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
TASK_EVIDENCE_TRUSTED_PROXY_IPS=127.0.0.1
TASK_EVIDENCE_SESSION_COOKIE_NAME=task_evidence_session
TASK_EVIDENCE_SESSION_COOKIE_SECURE=false
TASK_EVIDENCE_OIDC_ISSUER=
TASK_EVIDENCE_OIDC_SUBJECT_HEADER=X-Auth-Request-User
TASK_EVIDENCE_OIDC_EMAIL_HEADER=X-Auth-Request-Email
TASK_EVIDENCE_OIDC_GROUPS_HEADER=X-Auth-Request-Groups
TASK_EVIDENCE_OIDC_ADMIN_GROUPS=
TASK_EVIDENCE_SESSION_ABSOLUTE_SECONDS=28800
TASK_EVIDENCE_SESSION_IDLE_SECONDS=1800
TASK_EVIDENCE_REDIS_URL=
TASK_EVIDENCE_REDIS_REQUIRED=false
TASK_EVIDENCE_RATE_LIMIT_PREFIX=task-evidence-lab
VITE_RUM_ENDPOINT=
TASK_EVIDENCE_SESSION_COOKIE_SAMESITE=lax
TASK_EVIDENCE_SECURE_HEADERS=false
